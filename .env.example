# ============================================================
#  WhatsApp AI Assistant — Environment Variables
#  1. Copy this file to .env  (place it ONE level ABOVE docker/)
#  2. Fill in every value marked CHANGE_ME
#  3. Start with:  docker compose --env-file ..\.env up -d
#     (run that command from inside the docker/ folder)
# ============================================================

# IMPORTANT: use only letters and digits in passwords/keys below (no @ : / # ? $ ...).
# They are embedded in connection URLs. `bash scripts/setup.sh` generates safe values for you.

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=waassistant
POSTGRES_USER=wauser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ─── n8n ─────────────────────────────────────────────────────
# n8n v1+ no longer supports N8N_BASIC_AUTH_* variables.
# Login is now email + password through the owner account below.

# Generate a strong random key:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl

# Owner account — used to log in to n8n at http://localhost:5678
N8N_OWNER_EMAIL=admin@localhost.local
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=User

# Bcrypt hash of your n8n login password.
# Generate it (Linux/Mac):
#   htpasswd -bnBC 12 "" "YourPassword" | tr -d ':\n'
# Or run the helper script:
#   bash scripts/setup.sh
#
# !! KEEP THE SINGLE QUOTES !!  A bcrypt hash is full of "$" characters. Without
# single quotes Docker Compose (and bash) treat "$2b", "$12" ... as variables and
# silently mangle the hash, so n8n login fails.
N8N_OWNER_PASSWORD_HASH='CHANGE_ME_bcrypt_hash_of_your_password'

# For local dev (default):
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# Timezone for n8n scheduler nodes (e.g. Asia/Kolkata, America/New_York)
GENERIC_TIMEZONE=UTC

# For production VPS — uncomment and fill:
# N8N_HOST=n8n.yourdomain.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.yourdomain.com

# ─── Evolution API ───────────────────────────────────────────
# Generate:  openssl rand -hex 24
EVOLUTION_API_KEY=CHANGE_ME_generate_with_openssl

# URL n8n uses to call Evolution. It runs INSIDE Docker, so keep this as-is,
# even in production (do NOT point it at your public https:// domain).
EVOLUTION_BASE_URL=http://evolution:8080

# PUBLIC URL of Evolution as you open it in a browser.
# Local: http://localhost:8080      Production: https://evo.yourdomain.com
EVOLUTION_SERVER_URL=http://localhost:8080

# The WhatsApp instance name you will create after scanning QR.
# Used in the error-handler alert. Must match what you create in the UI.
EVOLUTION_INSTANCE_NAME=my-whatsapp

# ─── Google Gemini API (FREE) ────────────────────────────────
# Get a key at: https://aistudio.google.com/apikey  (free-tier limits change, check AI Studio)
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key
# gemini-2.0-flash was RETIRED by Google (June 2026) and now returns 404, and
# gemini-2.5-flash is being phased out. If you get "model not found", list what your
# key can call:  curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash
# Newer Gemini models spend part of this budget on internal "thinking", so keep it generous.
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.85
# Rate limits ("too many requests", HTTP 429): the workflow waits for the delay Gemini asks for and
# retries, for at most this many seconds in total, then tries the fallback models.
GEMINI_MAX_WAIT_SECONDS=50
# Optional comma-separated backup models used when the main one is rate-limited / unavailable.
# Use IDs from the model list command above, e.g. GEMINI_FALLBACK_MODELS=model-a,model-b
GEMINI_FALLBACK_MODELS=

# ─── Your Identity (used in AI persona) ─────────────────────
YOUR_NAME=Alex
YOUR_PHONE=+1234567890
YOUR_TIMEZONE=Asia/Kolkata

# ─── Escalation Alerts ───────────────────────────────────────
ESCALATION_PHONE=+1234567890
ESCALATION_EMAIL=you@example.com

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_COOLDOWN=3600

# ─── Contact Classification ──────────────────────────────────
# Comma-separated, with country code. Unknown numbers are treated as 'unknown'.
FAMILY_NUMBERS=+1111111111,+2222222222
FRIEND_NUMBERS=+3333333333,+4444444444

# ─── Security ────────────────────────────────────────────────
# Appended to the Evolution -> n8n webhook URL (?secret=...) and checked by the
# workflow, so only Evolution can trigger replies. Letters/digits only.
WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Portfolio booking bridge (see docs/BOOKING-INTEGRATION.md). Must equal N8N_BOOKING_WEBHOOK_SECRET on the
# portfolio site (Vercel). Leave empty to keep the booking workflow disabled (it then rejects everything).
BOOKING_WEBHOOK_SECRET=CHANGE_ME_booking_secret

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Network exposure ────────────────────────────────────────
# 127.0.0.1 = n8n/Evolution reachable only from the server itself (use an SSH tunnel).
# Use 0.0.0.0 only if you put HTTPS + IP restriction in front (README "Production").
BIND_ADDR=127.0.0.1
