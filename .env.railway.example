# ============================================================================
#  Railway variables, one block per service. Copy each block into that service's
#  Variables tab (Raw Editor), after replacing every <PLACEHOLDER>.
#  Service names are assumed to be exactly: Postgres, Redis, Evolution, n8n.
#  `${{Service.VAR}}` is Railway's reference syntax; Railway fills it in.
#  Use only letters and digits in passwords/keys (they end up inside URLs).
#  NEVER commit a real copy of this file.
# ============================================================================

# ───────────── Service: Postgres  (image: postgres:16-alpine, volume at /var/lib/postgresql/data) ─────────────
POSTGRES_DB=waassistant
POSTGRES_USER=wauser
POSTGRES_PASSWORD=<PG_PASSWORD>
PGDATA=/var/lib/postgresql/data/pgdata

# ───────────── Service: Redis  (image: redis:7-alpine) ─────────────
# Start command (Settings -> Deploy -> Custom Start Command):
#   redis-server --requirepass <REDIS_PASSWORD> --maxmemory 64mb --maxmemory-policy allkeys-lru

# ───────────── Service: Evolution  (image: evoapicloud/evolution-api:v2.3.7) ─────────────
SERVER_URL=https://<EVOLUTION_PUBLIC_DOMAIN>
SERVER_TYPE=http
SERVER_PORT=8080
CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS
LOG_COLOR=false
LOG_BAILEYS=error
DEL_INSTANCE=false
DATABASE_PROVIDER=postgresql
# connection_limit=5: Prisma's default pool is (CPU cores x 2 + 1) and on Railway it sees the HOST's cores,
# which can eat most of Postgres' 100 connection slots. Keep this small.
DATABASE_CONNECTION_URI=postgresql://wauser:<PG_PASSWORD>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/waassistant?schema=evolution&connection_limit=5
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
# Trial volume is only 0.5 GB: keep what Evolution stores small
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:<REDIS_PASSWORD>@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
WEBHOOK_GLOBAL_URL=http://${{n8n.RAILWAY_PRIVATE_DOMAIN}}:5678/webhook/whatsapp?secret=<WEBHOOK_SECRET>
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=<EVOLUTION_API_KEY>
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ───────────── Service: n8n  (image: n8nio/n8n:latest) ─────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_POOL_SIZE=4
DB_POSTGRESDB_DATABASE=waassistant
DB_POSTGRESDB_USER=wauser
DB_POSTGRESDB_PASSWORD=<PG_PASSWORD>
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=<YOUR_EMAIL>
N8N_INSTANCE_OWNER_FIRST_NAME=Admin
N8N_INSTANCE_OWNER_LAST_NAME=User
N8N_INSTANCE_OWNER_PASSWORD_HASH=<BCRYPT_HASH_starting_with_$2b$>
N8N_HOST=<N8N_PUBLIC_DOMAIN>
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://<N8N_PUBLIC_DOMAIN>
N8N_ENCRYPTION_KEY=<N8N_ENCRYPTION_KEY>
N8N_METRICS=false
# Keep the 0.5 GB volume from filling up: store only failed executions, for 3 days
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
N8N_LOG_LEVEL=info
GENERIC_TIMEZONE=Asia/Kolkata
# REQUIRED on the n8n service: n8n 2.x blocks $env in Code nodes by default -> "access to env vars denied".
# After adding/changing a Railway variable you must click Deploy (changes are staged until then).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Railway puts n8n behind a proxy
N8N_PROXY_HOPS=1
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.85
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_WAIT_SECONDS=50
EVOLUTION_BASE_URL=http://${{Evolution.RAILWAY_PRIVATE_DOMAIN}}:8080
EVOLUTION_API_KEY=<EVOLUTION_API_KEY>
EVOLUTION_INSTANCE_NAME=my-whatsapp
ESCALATION_PHONE=<+91XXXXXXXXXX>
YOUR_NAME=<YOUR_NAME>
YOUR_PHONE=<+91XXXXXXXXXX>
YOUR_TIMEZONE=Asia/Kolkata
FAMILY_NUMBERS=
FRIEND_NUMBERS=
RATE_LIMIT_PER_HOUR=20
WEBHOOK_SECRET=<WEBHOOK_SECRET>
# Portfolio booking bridge (docs/BOOKING-INTEGRATION.md): same value as N8N_BOOKING_WEBHOOK_SECRET on Vercel
BOOKING_WEBHOOK_SECRET=<BOOKING_WEBHOOK_SECRET>
# WhatsApp "STATUS:" command (docs/STATUS.md). Texting yourself from the connected number always works;
# add other phones here (comma-separated, with country code). Default expiry in hours (0 = never).
STATUS_OWNER_NUMBERS=
STATUS_DEFAULT_TTL_HOURS=12
